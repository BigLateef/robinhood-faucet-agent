# Copy to .env or export these variables before running.
# The wallet address is public; never put a private key here.
WALLET_ADDRESS=0x5814174290f0481dfeab44ae58757665f7c6f5bf
POLL_SECONDS=60
STATE_FILE=faucet-state.json
# Create a Discord webhook in the target channel and set its full value here.
DISCORD_WEBHOOK_URL=
# Set a long random value to protect the test endpoint.
TEST_ALERT_TOKEN=
